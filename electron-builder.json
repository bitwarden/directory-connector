{
  "extraMetadata": {
    "name": "bitwarden-directory-connector"
  },
  "productName": "Bitwarden Directory Connector",
  "appId": "com.bitwarden.directory-connector",
  "copyright": "Copyright © 2015-2026 Bitwarden Inc.",
  "directories": {
    "buildResources": "resources",
    "output": "dist",
    "app": "build"
  },
  "afterSign": "scripts/notarize.mjs",
  "asarUnpack": ["node_modules/dc-native/**"],
  "mac": {
    "artifactName": "Bitwarden-Connector-${version}-${arch}.${ext}",
    "category": "public.app-category.productivity",
    "gatekeeperAssess": false,
    "hardenedRuntime": true,
    "entitlements": "resources/entitlements.mac.plist",
    "entitlementsInherit": "resources/entitlements.mac.plist",
    "target": ["dmg", "zip"]
  },
  "win": {
    "target": ["portable", "nsis"],
    "signtoolOptions": {
      "sign": "scripts/sign.mjs"
    }
  },
  "linux": {
    "category": "Utility",
    "synopsis": "Sync your user directory to your Bitwarden organization.",
    "target": ["AppImage", "deb"]
  },
  "dmg": {
    "artifactName": "Bitwarden-Connector-${version}-${arch}.${ext}",
    "icon": "dmg.icns",
    "contents": [
      {
        "x": 150,
        "y": 185,
        "type": "file"
      },
      {
        "x": 390,
        "y": 180,
        "type": "link",
        "path": "/Applications"
      }
    ],
    "window": {
      "width": 540,
      "height": 380
    }
  },
  "nsis": {
    "oneClick": false,
    "perMachine": true,
    "allowToChangeInstallationDirectory": true,
    "artifactName": "Bitwarden-Connector-Installer-${version}.${ext}",
    "uninstallDisplayName": "${productName}",
    "deleteAppDataOnUninstall": true
  },
  "portable": {
    "artifactName": "Bitwarden-Connector-Portable-${version}.${ext}"
  },
  "deb": {
    "artifactName": "${name}_${version}_${arch}.${ext}",
    "maintainer": "Bitwarden Inc. <hello@bitwarden.com>",
    "packageCategory": "utils",
    "synopsis": "sync your user directory to your Bitwarden organization",
    "description": "Bitwarden Directory Connector synchronizes users and groups from your existing directory service into your Bitwarden organization. It supports Active Directory and other LDAP servers, Microsoft Entra ID, Google Workspace, Okta, and OneLogin.\n\nThis package provides the Directory Connector desktop application. The bwdc command line tool is distributed separately.",
    "depends": [
      "libgtk-3-0t64 | libgtk-3-0",
      "libatspi2.0-0t64 | libatspi2.0-0",
      "libatomic1",
      "libdbus-1-3",
      "libnotify4",
      "libnss3",
      "libsecret-1-0",
      "libuuid1",
      "libxss1",
      "libxtst6",
      "xdg-utils"
    ],
    "recommends": ["libayatana-appindicator3-1"]
  },
  "appImage": {
    "artifactName": "Bitwarden-Connector-${version}-${arch}.${ext}"
  }
}
